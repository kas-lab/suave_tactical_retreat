<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RetryUntilSuccessful num_attempts="-1">
      <Fallback>
        <is_mission_aborted/>
        <SequenceWithMemory>
          <SequenceWithMemory>
            <arm_thrusters/>
            <set_guided_mode/>
          </SequenceWithMemory>
          <SequenceWithMemory>
            <search_pipeline/>
            <inspect_pipeline/>
          </SequenceWithMemory>
        </SequenceWithMemory>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="arm_thrusters"
            editable="true"/>
    <Action ID="inspect_pipeline"
            editable="true"/>
    <Condition ID="is_mission_aborted"
               editable="true"/>
    <Action ID="search_pipeline"
            editable="true"/>
    <Action ID="set_guided_mode"
            editable="true"/>
  </TreeNodesModel>

</root>
