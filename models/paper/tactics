SpiralSearch {
  rule LowAltitde {...};
  rule MediumAltitude {
    guard {
      context(water_visibility < 3.25
        AND water_visibility >= 2.25)
      features(selected(suave_resolution.SearchPipeline))
    }
    action {
      select_variant(suave_resolution.MediumAltitude)
    }
  };
  rule HighAltitude {...};
}

RecoverThrusters {
  rule StartRecoverMotion {
    guard {
      context(c_thruster_1 == "False"
        OR c_thruster_2 == "False"
        OR c_thruster_3 == "False"
        OR c_thruster_4 == "False"
        OR c_thruster_5 == "False"
        OR c_thruster_6 == "False")
      features(!selected(suave_resolution.RecoverMotion))
    }
    action {
      select_variant(suave_resolution.RecoverMotion)
    }
  };
  rule EndRecoverMotion {...};
}
