name suave_tactics;
import "../system/suave.rossystem";
import "suave.context";
import "suave.var";
import "suave.resolution";

rule SEARCH_PIPELINE {
	guard {
		!selected(suave_resolution.SEARCH_PIPELINE)
	}
	action {
		select_variant(suave_resolution.SEARCH_PIPELINE)
	}
};

rule LOW_ALTITUDE {
	guard {
		water_visibility < 2.25
		AND selected(suave_resolution.SEARCH_PIPELINE)
	}
	action {
		select_variant(suave_resolution.LOW_ALTITUDE)
	}
};

rule MEDIUM_ALTITUDE {
	guard {
		water_visibility < 3.25
		AND water_visibility >= 2.25
		AND selected(suave_resolution.SEARCH_PIPELINE)
	}
	action {
		select_variant(suave_resolution.MEDIUM_ALTITUDE)
	}
};

rule HIGH_ALTITUDE {
	guard {
		water_visibility >= 3.25
		AND selected(suave_resolution.SEARCH_PIPELINE)
	}
	action {
		select_variant(suave_resolution.LOW_ALTITUDE)
	}
};

rule RECOVER_MOTION {
	guard {
		(c_thruster_1 == "FALSE" OR c_thruster_1 == "FALSE"
			OR c_thruster_2 == "FALSE" OR c_thruster_2 == "FALSE"
			OR c_thruster_3 == "FALSE" OR c_thruster_3 == "FALSE"
			OR c_thruster_4 == "FALSE" OR c_thruster_4 == "FALSE"
			OR c_thruster_5 == "FALSE" OR c_thruster_5 == "FALSE"
			OR c_thruster_6 == "FALSE" OR c_thruster_6 == "FALSE")
		AND !selected(suave_resolution.RECOVER_MOTION)
	}
	action {
		select_variant(suave_resolution.RECOVER_MOTION)
	}
};

rule END_RECOVER_MOTION {
	guard {
		(c_thruster_1 == "RECOVERED" OR c_thruster_1 == "OK")
			AND (c_thruster_2 == "RECOVERED" OR c_thruster_2 == "OK")
			AND (c_thruster_3 == "RECOVERED" OR c_thruster_3 == "OK")
			AND (c_thruster_4 == "RECOVERED" OR c_thruster_4 == "OK")
			AND (c_thruster_5 == "RECOVERED" OR c_thruster_5 == "OK")
			AND (c_thruster_6 == "RECOVERED" OR c_thruster_6 == "OK")
		AND selected(suave_resolution.RECOVER_MOTION)
	}
	action {
		unselect_variant(suave_resolution.RECOVER_MOTION)
	}
};

rule FOLLOW_PIPELINE {
	guard {
		!selected(suave_resolution.FOLLOW_PIPELINE)
	}
	action {
		select_variant(suave_resolution.FOLLOW_PIPELINE)
	}
};

rule RECHARGE {
	guard {
		!selected(suave_resolution.RECHARGE)
	}
	action {
		select_variant(suave_resolution.RECHARGE)
	}
};
