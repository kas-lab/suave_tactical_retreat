mavros:
  artifacts:
    mavros_node:
      node: /mavros/time
      publishers:
        'time_reference':
          type: 'sensor_msgs/msg/TimeReference'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: best_effort
            durability: volatile
        'timesync_status':
          type: 'mavros_msgs/msg/TimesyncStatus'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: best_effort
            durability: volatile
      parameters:
        'convergence_window':
          type: Integer
          value: 500
        'max_consecutive_high_deviation':
          type: Integer
          value: 10
        'max_consecutive_high_rtt':
          type: Integer
          value: 10
        'max_deviation_sample':
          type: Integer
          value: 10
        'max_rtt_sample':
          type: Integer
          value: 10
        'system_time_rate':
          type: Double
          value: 0.0
        'time_ref_source':
          type: String
          value: "fcu"
        'timesync_alpha_final':
          type: Double
          value: 0.003
        'timesync_alpha_initial':
          type: Double
          value: 0.05
        'timesync_beta_final':
          type: Double
          value: 0.003
        'timesync_beta_initial':
          type: Double
          value: 0.05
        'timesync_mode':
          type: String
          value: "MAVLINK"
        'timesync_rate':
          type: Double
          value: 1.0
        'use_sim_time':
          type: Boolean
          value: false
