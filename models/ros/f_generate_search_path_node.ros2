suave:
  artifacts:
    spiral_search:
      node: /f_generate_search_path_node
      publishers:
        'f_generate_search_path_node/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      serviceservers:
        'f_generate_search_path_node/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'f_generate_search_path_node/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'f_generate_search_path_node/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'f_generate_search_path_node/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'f_generate_search_path_node/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
      actionservers:
        'spiral_search':
          type: 'suave_msgs/action/SpiralSearch'
      parameters:
        'spiral_altitude':
          type: Double
          value: 1.0
        'use_sim_time':
          type: Boolean
          value: false
