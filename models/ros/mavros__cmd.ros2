mavros:
  artifacts:
    mavros_node:
      node: /mavros/cmd
      serviceservers:
        'cmd/arming':
          type: 'mavros_msgs/srv/CommandBool'
        'cmd/command':
          type: 'mavros_msgs/srv/CommandLong'
        'cmd/command_int':
          type: 'mavros_msgs/srv/CommandInt'
        'cmd/land':
          type: 'mavros_msgs/srv/CommandTOL'
        'cmd/land_local':
          type: 'mavros_msgs/srv/CommandTOLLocal'
        'cmd/set_home':
          type: 'mavros_msgs/srv/CommandHome'
        'cmd/takeoff':
          type: 'mavros_msgs/srv/CommandTOL'
        'cmd/takeoff_local':
          type: 'mavros_msgs/srv/CommandTOLLocal'
        'cmd/trigger_control':
          type: 'mavros_msgs/srv/CommandTriggerControl'
        'cmd/trigger_interval':
          type: 'mavros_msgs/srv/CommandTriggerInterval'
        'cmd/vtol_transition':
          type: 'mavros_msgs/srv/CommandVtolTransition'
      parameters:
        'command_ack_timeout':
          type: Double
          value: 5.0
        'use_comp_id_system_control':
          type: Boolean
          value: false
        'use_sim_time':
          type: Boolean
          value: false
