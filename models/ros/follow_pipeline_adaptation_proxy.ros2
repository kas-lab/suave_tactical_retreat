adapt_x:
  artifacts:
    adaptation_proxy:
      node: /follow_pipeline_adaptation_proxy
      subscribers:
        'requirements':
          type: 'adapt_x_msgs/msg/RelaxedRequirements'
      actionservers:
        'proxy_follow_pipeline':
          type: 'suave_msgs/action/FollowPipeline'
      actionclients:
        'follow_pipeline':
          type: 'suave_msgs/action/FollowPipeline'
