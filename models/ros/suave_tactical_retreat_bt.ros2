suave_tactical_retreat:
  artifacts:
    suave_tactical_retreat_bt:
      node: /suave_tactical_retreat_bt
      actionclients:
        'proxy_follow_pipeline':
          type: 'suave_msgs/action/FollowPipeline'
        'proxy_spiral_search':
          type: 'suave_msgs/action/SpiralSearch'
        'proxy_recover_thrusters':
          type: 'suave_msgs/action/RecoverThrusters'
