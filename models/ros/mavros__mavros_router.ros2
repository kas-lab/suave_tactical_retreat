mavros:
  artifacts:
    mavros_node:
      node: /mavros/mavros_router
      publishers:
        'diagnostics':
          type: 'diagnostic_msgs/msg/DiagnosticArray'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'uas1/mavlink_source':
          type: 'mavros_msgs/msg/Mavlink'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: best_effort
            durability: volatile
      subscribers:
        'uas1/mavlink_sink':
          type: 'mavros_msgs/msg/Mavlink'
      serviceservers:
        'mavros_router/add_endpoint':
          type: 'mavros_msgs/srv/EndpointAdd'
        'mavros_router/del_endpoint':
          type: 'mavros_msgs/srv/EndpointDel'
