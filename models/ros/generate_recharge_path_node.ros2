suave:
  artifacts:
    recharge_battery:
      node: /generate_recharge_path_node
      publishers:
        'generate_recharge_path_node/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      serviceservers:
        'generate_recharge_path_node/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'generate_recharge_path_node/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'generate_recharge_path_node/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'generate_recharge_path_node/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'generate_recharge_path_node/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
      actionservers:
        'recharge_battery':
          type: 'suave_msgs/action/RechargeBattery'
      parameters:
        'recharge_station_gz_pos':
          type: Array[Double]
          value: [-3.0, -2.0, -19.5]
        'use_sim_time':
          type: Boolean
          value: false
