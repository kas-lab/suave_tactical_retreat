$slc_nonodenamegiven_active_1 (node: $f_follow_pipeline_node_node) isa set_lifecycle_state, has lifecycle_state "active", has action_name "slc_nonodenamegiven_active_1";
$slc_nonodenamegiven_inactive_1 (node: $f_follow_pipeline_node_node) isa set_lifecycle_state, has lifecycle_state "inactive", has action_name "slc_nonodenamegiven_inactive_1";
$follow_pipeline_resolution_act (
	resolution_action: $slc_nonodenamegiven_active_1
, variant: $f_follow_pipeline) isa variant_activation;
$follow_pipeline_resolution_deact (
	resolution_action: $slc_nonodenamegiven_inactive_1
, variant: $f_follow_pipeline) isa variant_deactivation;
$slc_nonodenamegiven_active_2 (node: $generate_recharge_path_node_node) isa set_lifecycle_state, has lifecycle_state "active", has action_name "slc_nonodenamegiven_active_2";
$slc_nonodenamegiven_inactive_2 (node: $generate_recharge_path_node_node) isa set_lifecycle_state, has lifecycle_state "inactive", has action_name "slc_nonodenamegiven_inactive_2";
$recharge_resolution_act (
	resolution_action: $slc_nonodenamegiven_active_2
, variant: $f_recharge) isa variant_activation;
$recharge_resolution_deact (
	resolution_action: $slc_nonodenamegiven_inactive_2
, variant: $f_recharge) isa variant_deactivation;
$slc_nonodenamegiven_active_3 (node: $f_maintain_motion_node_node) isa set_lifecycle_state, has lifecycle_state "active", has action_name "slc_nonodenamegiven_active_3";
$slc_nonodenamegiven_inactive_3 (node: $f_maintain_motion_node_node) isa set_lifecycle_state, has lifecycle_state "inactive", has action_name "slc_nonodenamegiven_inactive_3";
$recover_motion_resolution_act (
	resolution_action: $slc_nonodenamegiven_active_3
, variant: $f_recover_motion) isa variant_activation;
$recover_motion_resolution_deact (
	resolution_action: $slc_nonodenamegiven_inactive_3
, variant: $f_recover_motion) isa variant_deactivation;
$res_suave_resolution (tactic: $ta_suave_tactics,
variant_resolution:$search_pipeline_resolution_act, variant_resolution:$search_pipeline_resolution_deact, 
				 variant_resolution:$low_altitude_resolution_act, 
				 variant_resolution:$medium_altitude_resolution_act, 
				 variant_resolution:$high_altitude_resolution_act, 
				 variant_resolution:$follow_pipeline_resolution_act, variant_resolution:$follow_pipeline_resolution_deact, 
				 variant_resolution:$recharge_resolution_act, variant_resolution:$recharge_resolution_deact, 
				 variant_resolution:$recover_motion_resolution_act, variant_resolution:$recover_motion_resolution_deact
				 )
 isa resolution_model,
    has resolution_model_name "suave_resolution", has ros_system "suave";
