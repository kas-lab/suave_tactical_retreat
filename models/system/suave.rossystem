    "/mavros/setpoint_position":
      from: "mavros./mavros/setpoint_position"
      interfaces:
        - "global_position/global": sub-> "mavros_node::global_position/global"
        - "local_position/pose": sub-> "mavros_node::local_position/pose"
        - "setpoint_position/global": sub-> "mavros_node::setpoint_position/global"
        - "setpoint_position/global_to_local": sub-> "mavros_node::setpoint_position/global_to_local"
        - "setpoint_position/local": sub-> "mavros_node::setpoint_position/local"
    "/mavros/sys":
      from: "mavros./mavros/sys"
      interfaces:
        - "battery": pub-> "mavros_node::battery"
        - "estimator_status": pub-> "mavros_node::estimator_status"
        - "extended_state": pub-> "mavros_node::extended_state"
        - "state": pub-> "mavros_node::state"
