      parameters:
        - "conn_timeout": "mavros_node::conn_timeout"
          value: 10.0
        - "disable_diag": "mavros_node::disable_diag"
          value: false
        - "heartbeat_mav_type": "mavros_node::heartbeat_mav_type"
