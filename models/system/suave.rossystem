suave:
  nodes:
    "/suave_runner_node":
      from: "suave_runner./suave_runner_node"
    "/gz_pipe_pose_bridge":
      from: "ros_gz_bridge./gz_pipe_pose_bridge"
      interfaces:
        - "model/min_pipes_pipeline/pose": pub-> "parameter_bridge::model/min_pipes_pipeline/pose"
        - "sub_model/min_pipes_pipeline/pose": sub-> "parameter_bridge::model/min_pipes_pipeline/pose"
    "/gz_bluerov_pose_bridge":
      from: "ros_gz_bridge./gz_bluerov_pose_bridge"
      interfaces:
        - "model/bluerov2/pose": pub-> "parameter_bridge::model/bluerov2/pose"
        - "sub_model/bluerov2/pose": sub-> "parameter_bridge::model/bluerov2/pose"
    "/mavros/mavros_node":
      from: "mavros./mavros/mavros_node"
      parameters:
        - "base_link_frame": "mavros_node::base_link_frame"
          value: ""
        - "fcu_url": "mavros_node::fcu_url"
          value: "udp://0.0.0.0:14550@14555"
        - "gcs_url": "mavros_node::gcs_url"
          value: ""
        - "map_frame": "mavros_node::map_frame"
          value: ""
        - "odom_frame": "mavros_node::odom_frame"
          value: ""
        - "tgt_component": "mavros_node::tgt_component"
          value: 1
        - "tgt_system": "mavros_node::tgt_system"
          value: 1
        - "use_sim_time": "mavros_node::use_sim_time"
          value: false
    "/mavros/mavros_router":
      from: "mavros./mavros/mavros_router"
      interfaces:
        - "diagnostics": pub-> "mavros_node::diagnostics"
        - "uas1/mavlink_source": pub-> "mavros_node::uas1/mavlink_source"
        - "uas1/mavlink_sink": sub-> "mavros_node::uas1/mavlink_sink"
        - "mavros_router/add_endpoint": ss-> "mavros_node::mavros_router/add_endpoint"
        - "mavros_router/del_endpoint": ss-> "mavros_node::mavros_router/del_endpoint"
    "/mavros/mavros":
      from: "mavros./mavros/mavros"
      interfaces:
        - "diagnostics": pub-> "mavros_node::diagnostics"
        - "tf": pub-> "mavros_node::tf"
        - "tf_static": pub-> "mavros_node::tf_static"
        - "uas1/mavlink_sink": pub-> "mavros_node::uas1/mavlink_sink"
        - "uas1/mavlink_source": sub-> "mavros_node::uas1/mavlink_source"
      parameters:
        - "base_link_frame_id": "mavros_node::base_link_frame_id"
          value: "base_link"
        - "component_id": "mavros_node::component_id"
          value: 191
        - "diagnostic_updater.period": "mavros_node::diagnostic_updater.period"
          value: 1.0
        - "diagnostic_updater.use_fqn": "mavros_node::diagnostic_updater.use_fqn"
          value: false
        - "fcu_protocol": "mavros_node::fcu_protocol"
          value: "v2.0"
        - "map_frame_id": "mavros_node::map_frame_id"
          value: "map"
        - "odom_frame_id": "mavros_node::odom_frame_id"
          value: "odom"
        - "plugin_allowlist": "mavros_node::plugin_allowlist"
          value: ['command', 'local_position', 'param', 'setpoint_position', 'sys_status', 'sys_time']
        - "plugin_denylist": "mavros_node::plugin_denylist"
          value: ['']
        - "system_id": "mavros_node::system_id"
          value: 1
        - "target_component_id": "mavros_node::target_component_id"
          value: 1
        - "target_system_id": "mavros_node::target_system_id"
          value: 1
        - "uas_url": "mavros_node::uas_url"
          value: "/uas1"
        - "use_sim_time": "mavros_node::use_sim_time"
          value: false
    "/mavros/cmd":
      from: "mavros./mavros/cmd"
      interfaces:
        - "cmd/arming": ss-> "mavros_node::cmd/arming"
        - "cmd/command": ss-> "mavros_node::cmd/command"
        - "cmd/command_int": ss-> "mavros_node::cmd/command_int"
        - "cmd/land": ss-> "mavros_node::cmd/land"
        - "cmd/land_local": ss-> "mavros_node::cmd/land_local"
        - "cmd/set_home": ss-> "mavros_node::cmd/set_home"
        - "cmd/takeoff": ss-> "mavros_node::cmd/takeoff"
        - "cmd/takeoff_local": ss-> "mavros_node::cmd/takeoff_local"
        - "cmd/trigger_control": ss-> "mavros_node::cmd/trigger_control"
        - "cmd/trigger_interval": ss-> "mavros_node::cmd/trigger_interval"
        - "cmd/vtol_transition": ss-> "mavros_node::cmd/vtol_transition"
    "/mavros/local_position":
      from: "mavros./mavros/local_position"
      interfaces:
        - "local_position/accel": pub-> "mavros_node::local_position/accel"
        - "local_position/odom": pub-> "mavros_node::local_position/odom"
        - "local_position/pose": pub-> "mavros_node::local_position/pose"
        - "local_position/pose_cov": pub-> "mavros_node::local_position/pose_cov"
        - "local_position/velocity_body": pub-> "mavros_node::local_position/velocity_body"
        - "local_position/velocity_body_cov": pub-> "mavros_node::local_position/velocity_body_cov"
        - "local_position/velocity_local": pub-> "mavros_node::local_position/velocity_local"
    "/mavros/param":
      from: "mavros./mavros/param"
      interfaces:
        - "param/event": pub-> "mavros_node::param/event"
        - "param/pull": ss-> "mavros_node::param/pull"
        - "param/set": ss-> "mavros_node::param/set"
      parameters:
        - "ACRO_BAL_PITCH": "mavros_node::ACRO_BAL_PITCH"
          value: 1.0
        - "ACRO_BAL_ROLL": "mavros_node::ACRO_BAL_ROLL"
          value: 1.0
        - "ACRO_EXPO": "mavros_node::ACRO_EXPO"
