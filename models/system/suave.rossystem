suave:
  nodes:
    "/gz_pipe_pose_bridge":
      from: "ros_gz_bridge./gz_pipe_pose_bridge"
      interfaces:
        - "model/min_pipes_pipeline/pose": pub-> "parameter_bridge::model/min_pipes_pipeline/pose"
        - "sub_model/min_pipes_pipeline/pose": sub-> "parameter_bridge::model/min_pipes_pipeline/pose"
    "/gz_bluerov_pose_bridge":
      from: "ros_gz_bridge./gz_bluerov_pose_bridge"
      interfaces:
        - "model/bluerov2/pose": pub-> "parameter_bridge::model/bluerov2/pose"
        - "sub_model/bluerov2/pose": sub-> "parameter_bridge::model/bluerov2/pose"
    "/water_visibility_observer_node":
      from: "suave_monitor./water_visibility_observer_node"
      interfaces:
        - "diagnostics": pub-> "water_visibility_observer::diagnostics"
      parameters:
        - "qa_publishing_period": "water_visibility_observer::qa_publishing_period"
          value: 1.0
        - "use_sim_time": "water_visibility_observer::use_sim_time"
          value: false
        - "water_visibility_max": "water_visibility_observer::water_visibility_max"
          value: 3.75
        - "water_visibility_min": "water_visibility_observer::water_visibility_min"
          value: 1.25
        - "water_visibility_period": "water_visibility_observer::water_visibility_period"
          value: 80
        - "water_visibility_sec_shift": "water_visibility_observer::water_visibility_sec_shift"
          value: 0.0
    "/battery_monitor":
      from: "suave_monitor./battery_monitor"
      interfaces:
        - "battery_monitor/recharge/complete": pub-> "battery_monitor::battery_monitor/recharge/complete"
        - "diagnostics": pub-> "battery_monitor::diagnostics"
        - "battery_monitor/recharge": ss-> "battery_monitor::battery_monitor/recharge"
      parameters:
        - "discharge_time": "battery_monitor::discharge_time"
          value: 200.0
        - "qa_publishing_period": "battery_monitor::qa_publishing_period"
          value: 1.0
        - "use_sim_time": "battery_monitor::use_sim_time"
          value: false
    "/detect_pipeline":
      from: "suave./detect_pipeline"
      interfaces:
        - "pipeline/detected": pub-> "pipeline_detection_wv::pipeline/detected"
        - "diagnostics": sub-> "pipeline_detection_wv::diagnostics"
        - "model/bluerov2/pose": sub-> "pipeline_detection_wv::model/bluerov2/pose"
        - "pipeline/get_path": ss-> "pipeline_detection_wv::pipeline/get_path"
    "/thruster_monitor":
      from: "suave_monitor./thruster_monitor"
      interfaces:
        - "diagnostics": pub-> "thruster_monitor::diagnostics"
      parameters:
        - "thruster_events": "thruster_monitor::thruster_events"
          value: ['(1,failure,35)']
        - "use_sim_time": "thruster_monitor::use_sim_time"
          value: false
    "/f_generate_search_path_node":
      from: "suave./f_generate_search_path_node"
      interfaces:
        - "f_generate_search_path_node/transition_event": pub-> "spiral_search::f_generate_search_path_node/transition_event"
        - "f_generate_search_path_node/change_state": ss-> "spiral_search::f_generate_search_path_node/change_state"
        - "f_generate_search_path_node/get_available_states": ss-> "spiral_search::f_generate_search_path_node/get_available_states"
        - "f_generate_search_path_node/get_available_transitions": ss-> "spiral_search::f_generate_search_path_node/get_available_transitions"
        - "f_generate_search_path_node/get_state": ss-> "spiral_search::f_generate_search_path_node/get_state"
        - "f_generate_search_path_node/get_transition_graph": ss-> "spiral_search::f_generate_search_path_node/get_transition_graph"
      parameters:
        - "spiral_altitude": "spiral_search::spiral_altitude"
          value: 1.0
        - "use_sim_time": "spiral_search::use_sim_time"
          value: false
    "/f_follow_pipeline_node":
      from: "suave./f_follow_pipeline_node"
      interfaces:
        - "pipeline/distance_inspected": pub-> "follow_pipeline::pipeline/distance_inspected"
        - "pipeline/inspected": pub-> "follow_pipeline::pipeline/inspected"
        - "f_follow_pipeline_node/transition_event": pub-> "follow_pipeline::f_follow_pipeline_node/transition_event"
        - "f_follow_pipeline_node/change_state": ss-> "follow_pipeline::f_follow_pipeline_node/change_state"
        - "f_follow_pipeline_node/get_available_states": ss-> "follow_pipeline::f_follow_pipeline_node/get_available_states"
        - "f_follow_pipeline_node/get_available_transitions": ss-> "follow_pipeline::f_follow_pipeline_node/get_available_transitions"
        - "f_follow_pipeline_node/get_state": ss-> "follow_pipeline::f_follow_pipeline_node/get_state"
        - "f_follow_pipeline_node/get_transition_graph": ss-> "follow_pipeline::f_follow_pipeline_node/get_transition_graph"
      parameters:
        - "use_sim_time": "follow_pipeline::use_sim_time"
          value: false
    "/generate_recharge_path_node":
      from: "suave./generate_recharge_path_node"
      interfaces:
        - "generate_recharge_path_node/transition_event": pub-> "recharge_battery::generate_recharge_path_node/transition_event"
        - "generate_recharge_path_node/change_state": ss-> "recharge_battery::generate_recharge_path_node/change_state"
        - "generate_recharge_path_node/get_available_states": ss-> "recharge_battery::generate_recharge_path_node/get_available_states"
        - "generate_recharge_path_node/get_available_transitions": ss-> "recharge_battery::generate_recharge_path_node/get_available_transitions"
        - "generate_recharge_path_node/get_state": ss-> "recharge_battery::generate_recharge_path_node/get_state"
        - "generate_recharge_path_node/get_transition_graph": ss-> "recharge_battery::generate_recharge_path_node/get_transition_graph"
      parameters:
        - "recharge_station_gz_pos": "recharge_battery::recharge_station_gz_pos"
          value: [-3.0, -2.0, -19.5]
        - "use_sim_time": "recharge_battery::use_sim_time"
          value: false
    "/f_maintain_motion_node":
      from: "suave./f_maintain_motion_node"
      interfaces:
        - "diagnostics": pub-> "recover_thrusters::diagnostics"
        - "f_maintain_motion_node/transition_event": pub-> "recover_thrusters::f_maintain_motion_node/transition_event"
        - "f_maintain_motion_node/change_state": ss-> "recover_thrusters::f_maintain_motion_node/change_state"
        - "f_maintain_motion_node/get_available_states": ss-> "recover_thrusters::f_maintain_motion_node/get_available_states"
        - "f_maintain_motion_node/get_available_transitions": ss-> "recover_thrusters::f_maintain_motion_node/get_available_transitions"
        - "f_maintain_motion_node/get_state": ss-> "recover_thrusters::f_maintain_motion_node/get_state"
        - "f_maintain_motion_node/get_transition_graph": ss-> "recover_thrusters::f_maintain_motion_node/get_transition_graph"
      parameters:
        - "use_sim_time": "recover_thrusters::use_sim_time"
          value: false
    "/mission_metrics":
      from: "suave_metrics./mission_metrics"
      interfaces:
        - "diagnostics": sub-> "mission_metrics::diagnostics"
        - "f_maintain_motion_node/transition_event": sub-> "mission_metrics::f_maintain_motion_node/transition_event"
        - "generate_recharge_path_node/transition_event": sub-> "mission_metrics::generate_recharge_path_node/transition_event"
        - "pipeline/detected": sub-> "mission_metrics::pipeline/detected"
        - "pipeline/distance_inspected": sub-> "mission_metrics::pipeline/distance_inspected"
        - "pipeline/inspected": sub-> "mission_metrics::pipeline/inspected"
        - "mission_metrics/save": ss-> "mission_metrics::mission_metrics/save"
    "/mission_node":
      from: "suave_missions./mission_node"
      interfaces:
        - "diagnostics": sub-> "mission_node::diagnostics"
        - "pipeline/detected": sub-> "mission_node::pipeline/detected"
        - "pipeline/inspected": sub-> "mission_node::pipeline/inspected"
      parameters:
        - "time_limit": "mission_node::time_limit"
          value: 300
        - "use_sim_time": "mission_node::use_sim_time"
          value: false

